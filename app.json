{
  "expo": {
    "name": "Aura Health Platform",
    "slug": "aura-health-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F4E79"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.gov.health.aurahealth",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Aura Health requires calendar access to add your healthcare appointment reminders.",
        "NSRemindersUsageDescription": "Aura Health requires reminder access to alert you prior to your clinic queue time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4E79"
      },
      "package": "za.gov.health.aurahealth",
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR", "SEND_SMS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Aura Health needs permission to sync your medical appointment dates to your device calendar."
        }
      ]
    ]
  }
}
